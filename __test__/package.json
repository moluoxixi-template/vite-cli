    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test:unit && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/fs-extra": "catalog:type",
    "@types/node": "catalog:type",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "execa": "^9.6.1",
    "fs-extra": "catalog:build",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "^4.0.17"
  }
}
