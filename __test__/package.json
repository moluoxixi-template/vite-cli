{
  "name": "@moluoxixi/vite-cli-test",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Test suite for @moluoxixi/create-app",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:e2e": "vitest run e2e",
    "test:watch": "vitest watch",
